# ============================================================
#  منصة «مطرحك» — مطرحك معروف، وبلاغك متابع (Matrahak)
#  انسخ هذا الملف إلى .env ثم:  php artisan key:generate
# ============================================================

APP_NAME="Matrahak"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# عنوان الخادم كما تراه التطبيقات (للهاتف الحقيقي استخدم IP جهازك على الشبكة: http://192.168.1.10:8000)
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Damascus

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------- قاعدة البيانات (MySQL 8 / MariaDB 10.6+) ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_city_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync: لا حاجة لتشغيل queue:work — المهام الثقيلة تُنفَّذ بعد إرسال الرد (afterResponse)
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@matrahak.sy"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- خدمة الذكاء الاصطناعي (مجلد matrahak-ai — Python FastAPI) — اختيارية ----------
# إن كانت متوقفة يعمل البديل المحلي داخل Laravel تلقائياً (تصنيف/تكرار/تنبؤ/رؤى/خطورة)
AI_SERVICE_URL=http://127.0.0.1:8001
# يجب أن يطابق INTERNAL_API_KEY في ملف .env لخدمة Python
AI_SERVICE_KEY=change-this-internal-key
AI_SERVICE_TIMEOUT=8

# ---------- Firebase Cloud Messaging (Push) — اختياري ----------
# مسار ملف Service Account (نسبي من جذر المشروع). بدونه تبقى الإشعارات داخل التطبيقين فقط.
FIREBASE_CREDENTIALS=
# FIREBASE_CREDENTIALS=storage/app/firebase/firebase-credentials.json
FIREBASE_PROJECT_ID=

# ---------- إعدادات المنصة ----------
TICKET_PREFIX=MTR
# ---------- الهوية ----------
BRAND_NAME="مطرحك"
BRAND_OWNER="الجمهورية العربية السورية"
# شعار الدولة الرسمي: true للعرض الأكاديمي — عند النشر العام يلزم موافقة الجهة الرسمية أو ضع false
BRAND_STATE_EMBLEM=true

# مقياس مؤشر خطورة المحافظات (ارفعه عندما يكبر حجم الاستخدام)
RISK_LOAD_SCALE=1.0
RISK_OVERDUE_SCALE=0.5
