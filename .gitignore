# Matrahak - safety net (each project also has its own .gitignore)
# Secrets and local machine settings are never published
.env
.env.*
!.env.example
*.jks
*.keystore
*.pem
*.p12
*.pfx
key.properties
local.properties
google-services.json
GoogleService-Info.plist
auth.json

# Dependencies and build output
vendor/
node_modules/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
.gradle/

# Editors, OS, logs
.idea/
*.iml
.DS_Store
Thumbs.db
*.log
.phpunit.result.cache
