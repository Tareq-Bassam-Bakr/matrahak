# ===== خدمة الذكاء الاصطناعي — مطرحك =====
# يجب أن يطابق AI_SERVICE_KEY في ملف .env الخاص بـ Laravel (غيّره لقيمة عشوائية طويلة)
INTERNAL_API_KEY=change-this-internal-key

HOST=127.0.0.1
PORT=8001

# تدريب النموذج تلقائياً عند التشغيل إن لم يوجد أو اختلف إصدار scikit-learn
AUTO_TRAIN=true

# وزن الكلمات المفتاحية في النموذج الهجين — اتركه فارغاً لاستخدام الوزن المختار عبر Grouped CV (0.3)
# KEYWORD_WEIGHT=0.3
