@startuml erd-3-security-system
skinparam defaultFontName Cairo
skinparam defaultFontSize 13
skinparam dpi 160
skinparam shadowing false
skinparam roundcorner 8
skinparam nodesep 45
skinparam ranksep 55
skinparam ArrowColor #4B5563
skinparam ArrowThickness 1.1
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #0F6B4A
  BorderThickness 1.3
  HeaderBackgroundColor #E7F2EC
  FontStyle bold
  AttributeFontSize 12
  StereotypeFontSize 10
}
hide circle
hide methods
hide stereotype

title <size:18>مخطط الكيانات والعلاقات (3): الصلاحيات (RBAC) والإشعارات والتدقيق</size>
top to bottom direction
entity "users\n<size:11>المستخدمون</size>" as users {
  * <b>id</b> : bigint <color:#0F6B4A>PK</color>
  --
  * uuid : char(36) <color:#1D4ED8>UQ</color>
  * name : varchar(100)
  * email : varchar(150) <color:#1D4ED8>UQ</color>
    phone : varchar(20) <color:#1D4ED8>UQ</color>
    national_id : varchar(20) <color:#1D4ED8>UQ</color>
    department_id : bigint <color:#B45309>FK</color>
    district_id : bigint <color:#B45309>FK</color>
  <i><color:#6B7280>… 11 أعمدة أخرى</color></i>
}
entity "roles\n<size:11>الأدوار</size>" as roles {
  * <b>id</b> : bigint <color:#0F6B4A>PK</color>
  --
  * name : varchar(255)
  * guard_name : varchar(255)
  <color:#6B7280><size:10>created_at · updated_at</size></color>
}
entity "permissions\n<size:11>الصلاحيات</size>" as permissions {
  * <b>id</b> : bigint <color:#0F6B4A>PK</color>
  --
  * name : varchar(255)
  * guard_name : varchar(255)
  <color:#6B7280><size:10>created_at · updated_at</size></color>
}
entity "role_has_permissions\n<size:11>صلاحيات الأدوار</size>" as role_has_permissions {
  * <b>permission_id</b> : bigint <color:#0F6B4A>PK</color>
  * <b>role_id</b> : bigint <color:#0F6B4A>PK</color>
  --
}
entity "model_has_roles\n<size:11>أدوار المستخدمين</size>" as model_has_roles {
  * <b>role_id</b> : bigint <color:#0F6B4A>PK</color>
  * <b>model_type</b> : varchar(255) <color:#0F6B4A>PK</color>
  * <b>model_id</b> : bigint <color:#0F6B4A>PK</color>
  --
}
entity "model_has_permissions\n<size:11>صلاحيات مباشرة</size>" as model_has_permissions {
  * <b>permission_id</b> : bigint <color:#0F6B4A>PK</color>
  * <b>model_type</b> : varchar(255) <color:#0F6B4A>PK</color>
  * <b>model_id</b> : bigint <color:#0F6B4A>PK</color>
  --
}
entity "personal_access_tokens\n<size:11>رموز الدخول Sanctum</size>" as personal_access_tokens {
  * <b>id</b> : bigint <color:#0F6B4A>PK</color>
  --
  * tokenable_type : varchar(255)
  * tokenable_id : bigint
  * name : text
  * token : varchar(64) <color:#1D4ED8>UQ</color>
    abilities : text
    last_used_at : timestamp
    expires_at : timestamp
  <color:#6B7280><size:10>created_at · updated_at</size></color>
}
entity "notifications\n<size:11>الإشعارات</size>" as notifications {
  * <b>id</b> : char(36) <color:#0F6B4A>PK</color>
  --
  * type : varchar(255)
  * notifiable_type : varchar(255)
  * notifiable_id : bigint
  * data : text
    read_at : timestamp
  <color:#6B7280><size:10>created_at · updated_at</size></color>
}
entity "audit_logs\n<size:11>سجل التدقيق</size>" as audit_logs {
  * <b>id</b> : bigint <color:#0F6B4A>PK</color>
  --
    user_id : bigint <color:#B45309>FK</color>
  * action : varchar(100)
    model_type : varchar(150)
    model_id : bigint
    old_values : json
    new_values : json
    ip_address : varchar(45)
    user_agent : varchar(500)
  <color:#6B7280><size:10>created_at</size></color>
}
entity "settings\n<size:11>إعدادات النظام</size>" as settings {
  * <b>id</b> : bigint <color:#0F6B4A>PK</color>
  --
  * key : varchar(100) <color:#1D4ED8>UQ</color>
    value : json
  <color:#6B7280><size:10>created_at · updated_at</size></color>
}
users |o--o{ audit_logs : <size:10>user_id</size>
permissions ||--o{ model_has_permissions : <size:10>permission_id</size>
roles ||--o{ model_has_roles : <size:10>role_id</size>
permissions ||--o{ role_has_permissions : <size:10>permission_id</size>
roles ||--o{ role_has_permissions : <size:10>role_id</size>
users |o..o{ notifications : <size:10>notifiable_type, notifiable_id (polymorphic)</size>
users |o..o{ personal_access_tokens : <size:10>tokenable_type, tokenable_id (polymorphic)</size>
users |o..o{ model_has_roles : <size:10>model_type, model_id (polymorphic)</size>
users |o..o{ model_has_permissions : <size:10>model_type, model_id (polymorphic)</size>
@enduml
